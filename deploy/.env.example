# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，严禁提交
# 生成随机 token: openssl rand -hex 16

# 音箱 client 鉴权 token（与音箱端 client 无关，是 bridge 服务端连接鉴权）
OPEN_XIAOAI_TOKEN=

# DeepSeek API Key（https://platform.deepseek.com）
# 注意：面板里保存过新 Key 之后，以面板值为准（存 data/runtime-overrides.json），
# 本变量只作为初始兜底。
DEEPSEEK_API_KEY=

# Home Assistant 长期访问令牌（HA 用户→安全→长期访问令牌，有效期可设 10 年）
HA_TOKEN=

# HA 地址（群晖 host 网络下默认即可）
HA_BASE_URL=http://10.10.10.2:8123

# ============ 后台面板 ============
# 面板访问令牌（http://<nas>:9092/admin 登录用），必填，务必强随机
ADMIN_TOKEN=

# 面板「外部服务」探测列表（总览页显示各服务在线状态）
# aurora 网关部署在同一台群晖 :8080（Authorization 值见 aurora compose 的 Authorization 变量）
MONITOR_SERVICES=[{"name":"aurora","url":"http://127.0.0.1:8080/v1/models","auth":"Bearer david"},{"name":"home-assistant","url":"http://127.0.0.1:8123/api/","auth":"Bearer 替换为HA_TOKEN"}]
