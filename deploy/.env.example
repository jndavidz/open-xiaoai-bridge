# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，严禁提交
# 生成随机 token: openssl rand -hex 16

# 音箱 client 鉴权 token（必填；client 侧从 /data/open-xiaoai/token.txt 读取同值）
# 留空 = 服务端拒绝所有 client 连接（fail closed）
OPEN_XIAOAI_TOKEN=

# 业务 HTTP API token（必填；写类端点需 Authorization: Bearer <该值>）
# 留空 = 写类端点 503 失败关闭（读类/健康检查仍可用）
# 升级顺序：先给 HA/企业微信/脚本等调用方配好 token，再设置本变量
BRIDGE_API_TOKEN=

# 具名 token 集合（票 12，可选）：label:token 逗号分隔，审计日志按 label 区分调用方
# 生成随机 token: openssl rand -hex 16（label 限 [a-z0-9-]{1,32}）
# 例：BRIDGE_API_TOKENS=ha-tts:<t>,wecom:<t>,pc-inject:<t>,ops:<t>,agent-skill:<t>
# 与 BRIDGE_API_TOKEN 并存时旧值作为 label=legacy 继续有效（迁移窗口，收口即删）；
# 任一条目非法 / label 重复 / token 值重复 ⇒ 整份判非法，写类端点 503 auth_config_invalid
BRIDGE_API_TOKENS=

# PC 语音注入模块（可选；默认关闭）
# 留空 = 关闭：不监听 :9093，注入端点 503，主对话不受影响
# 1/true/yes/on = 开启：窗口 = 闸门 + 中继 + 唤醒，三者同开同关
INJECT_ENABLE=

# 9093 数据面鉴权（票 12）：开启注入后，未配 CIDR 且未显式允许匿名 ⇒ 拒绝监听 9093
# 设备 IP 白名单（逗号分隔 CIDR；建议设备 /32，DHCP 漂移需在路由器做静态租约）
INJECT_ALLOW_CIDR=
# 仅临时排障用：显式允许无鉴权裸奔（1/true/yes/on）
INJECT_ALLOW_ANON=

# 每轮延迟埋点（可选；默认关闭）
# 留空 = 关闭（零日志、零行为变化）
# 1/true/yes/on = 开启：每轮一条 [TurnTrace] INFO 数值行（各段 ms/长度/标志，不含原话）
TURN_TRACE_ENABLED=

# 初始 API Key 兜底（https://platform.deepseek.com 或其他 OpenAI 兼容服务）
# 注意：后台面板保存过新 Key 之后以面板值为准（存 data/runtime-overrides.json），
# 本变量只在从未用面板修改时生效。
DEEPSEEK_API_KEY=

# Home Assistant 长期访问令牌（HA 用户→安全→长期访问令牌，有效期可设 10 年）
HA_TOKEN=

# HA 地址（群晖 host 网络下默认即可）
HA_BASE_URL=http://10.10.10.2:8123

# ============ 后台面板 ============
# 面板访问令牌（http://<nas>:9092/admin 登录用），必填，务必强随机
ADMIN_TOKEN=

# 可选：总览页「外部服务」探测列表（JSON 数组）；留空 = 不展示该区块。
# 与对话后端完全无关，纯状态监控，想监控谁就填谁（OpenAI 兼容网关/HA/任意 HTTP 服务）。
# 例（探测任意服务的健康端点）：
# MONITOR_SERVICES=[{"name":"my-gateway","url":"http://127.0.0.1:<port>/v1/models","auth":"Bearer <token>"}]
MONITOR_SERVICES=
